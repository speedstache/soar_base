<div class="container my-2">
	<div class="row text-center justify-content-center" >
    <h4>Update Personal Info for <%= @user.username %> </h4>
    <div class="col-sm-10 col-md-6">
      <div class="shadow p-3 mb-3 bg-info rounded text-start">
        <%= render 'shared/errors', obj: @user, wrapper_class: "profile-form-errors" %>
        <% if @user.id == current_user.id %>
          <section class="mb-4">
          <h5>Profile image</h5>
          <%= profile_image_for @user, size: 100 %>
          <%= render "shared/profile_image_editor", form_url: profile_image_path, form_method: :post %>
          <% if @user.profile_image_attached? %>
            <%= button_to "Remove profile image", profile_image_path, method: :delete, class: "btn btn-outline-secondary btn-sm mt-2", form: { data: { turbo_confirm: "Remove your profile image?" } } %>
          <% end %>
          </section>
        <% end %>
        <hr class="my-4">
        <h5>Personal information</h5>
        <%= render 'form', form_class: "profile-details-form" %>
      </div>
    </div>
  </div>
</div> 
