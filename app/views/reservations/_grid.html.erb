<div class="table-responsive mt-2 ">
	<table class="table table-striped">
		<thead>
			<tr>
				<th >Aircraft</th>
				<% @avail_hours.each do |hour| %>
					<th><%= hour.hour %></th>
					<% end %>
			</tr>
		</thead>
		<tbody>
			<% @grid_aircraft.each do |grid_item| %>
				<tr>
				<td><%= grid_item[:aircraft].short_name %></td>
				<% @avail_hours.each do |hour| %>
					<td >
						<% if has_membership == true && @res_show >= 15.days.ago %>
							<% if grid_item[:reservations].where(reservation_time: hour.hour).exists? %>
								<%= link_to '', reservation_path(grid_item[:reservations].where(reservation_time: hour.hour).pluck(:id)), :class=>"closed_dot" %>
							<% elsif grid_item[:aircraft].active_flag == true %>
								<%= link_to '', new_reservation_path(:date => @res_show.strftime("%a, %b %d, %Y"), :time => hour.hour, :aircraft => grid_item[:aircraft].id), :class=>"open_dot" %>
							<% else %>
								<span class="gray_dot" title="Aircraft is currently offline"></span>
							<% end %>
						<% else %>	
							<% if grid_item[:reservations].where(reservation_time: hour.hour).exists? %>
								<%= link_to '', reservation_path(grid_item[:reservations].where(reservation_time: hour.hour).pluck(:id)), :class=>"closed_dot" %>
							<% else %>
								<% if @res_show < 15.days.ago %>
									<span class="gray_dot" title="Reservations cannot be created for dates that far in the past"></span>
								<% elsif !aircraft_privilege_ids.include?(grid_item[:aircraft].id) %>
									<span class="gray_dot" title="No reservation privileges for this aircraft"></span>
								<% else %>
									<span class="gray_dot" title="Reservation privileges only for active memberships"></span>
								<% end %>
							<% end %>
						<% end %>	
					</td>
				<% end %>
				</tr>
			<% end %>
		</tbody>
	</table>
</div>
	